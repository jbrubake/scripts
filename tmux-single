#!/bin/sh
#
# abstract: start tmux only if session is not attached elsewhere, otherwise spawn $SHELL

if [ -z "$1" ] || ! command -v tmux >/dev/null; then
    exec $SHELL
fi

if ! tmux has-session -t "$1" 2>/dev/null; then
    exec tmux new-session -s "$1"
elif [ "$(tmux list-sessions -f "#{m:#S,$1}" -F '#{session_attached}')" = 0 ]; then
    if command -v tmuxp >/dev/null; then
        exec tmuxp load -y "$1"
    else
        exec tmux attach-session -t "$1"
    fi
else
    exec $SHELL
fi
