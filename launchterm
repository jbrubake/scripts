#!/bin/sh
#
# abstract: start a terminal (and optional command) with tabbed(1)

print_help() {
    printf 'Usage: %s [-t TERMINAL] [-n WINDOW_NAME] [COMMAND STRING]\n' "$0"
} >&2

name=
term=xterm
while getopts ":n:t:" opt; do
    case $opt in
        n) name=$OPTARG ;;
        t) term=$OPTARG ;;
        *) print_help; exit ;;
    esac
done
shift $((OPTIND-1))

case $term in
    alacritty)
        args="-r2 alacritty --embed ID ${1:+-e}"
        ;;
    xterm)
        args="-r2 xterm -into ID ${1:+-e}"
        ;;
esac

exec tabbed -c "${name:+-n "$name"}" $args "$@"
